# ===============================================================
# .env.example — copie para .env e preencha com seus valores reais.
# NUNCA suba o .env de verdade para o Git (o .gitignore já protege isso).
# ===============================================================

# ---------------------------------------------------------------
# TELEGRAM (obrigatório)
# ---------------------------------------------------------------
# Token do bot, obtido com o @BotFather (t.me/BotFather) via /newbot
TELEGRAM_BOT_TOKEN=

# ID do canal onde as ofertas serão publicadas. Para canais é um número
# negativo começando com -100 (ex: -1001234567890). Descubra encaminhando
# uma mensagem do canal para @userinfobot, ou use @seucanal se for público.
# IMPORTANTE: o bot precisa ser ADMINISTRADOR do canal com permissão de
# "Postar mensagens", senão a publicação falha.
TELEGRAM_CHANNEL_ID=

# ---------------------------------------------------------------
# IA / ANTHROPIC (obrigatório — usada para gerar o texto da oferta)
# ---------------------------------------------------------------
# Crie uma chave em https://console.anthropic.com
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------
# BANCO DE DADOS
# ---------------------------------------------------------------
# Padrão: SQLite local (não precisa configurar nada). Para PostgreSQL em
# produção, use algo como:
# DATABASE_URL=postgresql://usuario:senha@host:5432/nome_do_banco
DATABASE_URL=sqlite:///ofertas.db

# ---------------------------------------------------------------
# MERCADO LIVRE (obrigatório para o coletor do ML funcionar)
# ---------------------------------------------------------------
# Crie uma aplicação em https://developers.mercadolivre.com.br/
MERCADOLIVRE_CLIENT_ID=
MERCADOLIVRE_CLIENT_SECRET=
MERCADOLIVRE_REFRESH_TOKEN=
# Tag/ferramenta de afiliado do seu cadastro em mercadolivre.com.br/afiliados
ML_MATT_TOOL=
ML_AFFILIATE_TAG=

# ---------------------------------------------------------------
# SHOPEE (opcional — necessário só se você já foi aprovado no programa
# de afiliados da Shopee em https://affiliate.shopee.com.br)
# ---------------------------------------------------------------
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=
SHOPEE_AFFILIATE_TAG=

# ---------------------------------------------------------------
# AMAZON (opcional — coletor ainda desativado por padrão em
# scheduler/pipeline.py; preencha só se for reativar)
# ---------------------------------------------------------------
# AMAZON_ACCESS_KEY=
# AMAZON_SECRET_KEY=
# AMAZON_AFFILIATE_TAG=

# ---------------------------------------------------------------
# REGRAS DE NEGÓCIO
# ---------------------------------------------------------------
# Desconto mínimo (%) para uma oferta ser considerada válida
DESCONTO_MINIMO_PERCENTUAL=30

# ---------------------------------------------------------------
# IDENTIDADE VISUAL DO CARD GERADO
# ---------------------------------------------------------------
MARCA_DAGUA_RODAPE=@SeuCanalAqui
PASTA_IMAGENS_GERADAS=generated_images

# ---------------------------------------------------------------
# EXPIRAÇÃO DE OFERTAS
# ---------------------------------------------------------------
VERIFICACAO_EXPIRACAO_INTERVALO_MINUTOS=120
VERIFICACAO_EXPIRACAO_IDADE_MINIMA_HORAS=2
# "editar" (marca visualmente como expirada) ou "apagar" (remove o post)
ACAO_AO_EXPIRAR=editar

# ---------------------------------------------------------------
# REPOSTAGEM AUTOMÁTICA
# ---------------------------------------------------------------
REPOSTAGEM_AUTOMATICA_ATIVA=true
REPOSTAGEM_DESCONTO_MINIMO=50
REPOSTAGEM_INTERVALO_HORAS=72
REPOSTAGEM_MAX_VEZES=3

# ---------------------------------------------------------------
# SINCRONIZAÇÃO DE CONVERSÕES (SHOPEE)
# ---------------------------------------------------------------
SINCRONIZACAO_CONVERSOES_INTERVALO_HORAS=6
SINCRONIZACAO_CONVERSOES_DIAS_RETROATIVOS=3

# ---------------------------------------------------------------
# AGENDAMENTO
# ---------------------------------------------------------------
# Intervalo (minutos) entre buscas de novas ofertas
INTERVALO_BUSCA_MINUTOS=60

# ---------------------------------------------------------------
# MODERAÇÃO
# ---------------------------------------------------------------
# "true" = ofertas ficam pendentes de aprovação manual no painel admin
# antes de poderem ser publicadas. "false" = aprovação automática.
REQUER_APROVACAO_MANUAL=false

# ---------------------------------------------------------------
# LOGS
# ---------------------------------------------------------------
LOG_DIR=logs
LOG_LEVEL=INFO

# ---------------------------------------------------------------
# PAINEL ADMINISTRATIVO (Flask)
# ---------------------------------------------------------------
# Defina um valor fixo em produção (senão as sessões/flash messages se
# perdem a cada restart do processo, já que o padrão é aleatório).
FLASK_SECRET_KEY=troque-por-uma-string-aleatoria-fixa
